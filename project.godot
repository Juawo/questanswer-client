; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="QuestAnswer"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://bt2b0f2dhkjx4"

[autoload]

SessionState="*res://scripts/autoloads/SessionState.gd"
ApiManager="*res://scripts/autoloads/APIManager.gd"
SaveManager="*res://scripts/autoloads/SaveManager.gd"
SceneTrasition="*res://scenes/scene_trasition.tscn"
AudioManager="*uid://ct2newkaoo4vj"

[display]

window/size/viewport_width=412
window/size/viewport_height=917
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[file_customization]

folder_colors={
"res://assets/": "purple",
"res://configs/": "gray",
"res://scenes/": "green",
"res://scripts/": "yellow"
}

[gui]

common/snap_controls_to_pixels=false
theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
